{
  "name": "blockviewer-temp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "cd src/wasm-mesher && wasm-pack build --target web --out-dir ../mesh/wasm/pkg",
    "build:wasm:release": "cd src/wasm-mesher && wasm-pack build --target web --release --out-dir ../mesh/wasm/pkg",
    "build:wasm:parallel": "bash scripts/build-wasm-parallel.sh",
    "build:wasm:parallel:win": "powershell -ExecutionPolicy Bypass -File scripts/build-wasm-parallel.ps1",
    "dev": "vite",
    "dev:wasm": "npm run build:wasm && vite",
    "build": "npm run build:wasm:release && vite build",
    "build:js-only": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node test/mesh.test.js",
    "test:update": "node test/mesh.test.js --update",
    "test:mesh": "node test/mesh/meshConsistency.test.js",
    "test:mesh:update": "node test/mesh/meshConsistency.test.js --update",
    "test:e2e": "node test/e2e/regionDisplay.test.js",
    "test:e2e:regression": "HEADLESS=1 node test/e2e/screenshotRegression.test.js",
    "test:e2e:update-baseline": "HEADLESS=1 node test/e2e/screenshotRegression.test.js --update",
    "test:regression": "HEADLESS=1 node test/e2e/regression.test.js",
    "test:regression:update": "HEADLESS=1 node test/e2e/regression.test.js --update",
    "test:regression:visible": "HEADLESS=0 node test/e2e/regression.test.js",
    "test:block": "HEADLESS=1 node test/e2e/blockRegression.test.js",
    "test:block:update": "HEADLESS=1 node test/e2e/blockRegression.test.js --update",
    "test:block:visible": "HEADLESS=0 node test/e2e/blockRegression.test.js",
    "test:block:subset": "HEADLESS=1 node test/e2e/blockRegression.test.js --subset",
    "test:block:subset:update": "HEADLESS=1 node test/e2e/blockRegression.test.js --subset --update",
    "test:block:subset:visible": "HEADLESS=0 node test/e2e/blockRegression.test.js --subset",
    "test:performance": "HEADLESS=1 node test/e2e/performance.test.js",
    "test:performance:visible": "HEADLESS=0 node test/e2e/performance.test.js",
    "test:benchmark": "node test/e2e/performanceBenchmark.test.js",
    "test:benchmark:headless": "HEADLESS=1 node test/e2e/performanceBenchmark.test.js",
    "test:nav-benchmark": "node test/e2e/navigationBenchmark.test.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "jszip": "^3.10.1",
    "pako": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "adm-zip": "^0.5.16",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.34.0",
    "selenium-webdriver": "^4.27.0",
    "vite": "^7.2.4"
  }
}
